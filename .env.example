# Copy this file to .env and fill in your real values.

ROUTER_IP=192.168.1.1
ROUTER_LOGIN=admin
ROUTER_PASSWORD=change-me
APP_HOST=0.0.0.0
APP_PORT=8000

# Watchdog configuration (optional)
WATCHDOG_ENABLED=true
WATCHDOG_TIMEOUT_SECONDS=900
WATCHDOG_CHECK_INTERVAL_SECONDS=30
WATCHDOG_REBOOT_COOLDOWN_SECONDS=300
