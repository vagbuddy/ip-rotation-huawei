# Managed by Ansible.
ROUTER_IP={{ router_ip }}
ROUTER_LOGIN={{ router_login }}
ROUTER_PASSWORD={{ router_password }}
APP_HOST={{ app_host }}
APP_PORT={{ app_port }}
{% if watchdog_enabled is defined %}
WATCHDOG_ENABLED={{ watchdog_enabled | lower }}
{% endif %}
{% if watchdog_timeout_seconds is defined %}
WATCHDOG_TIMEOUT_SECONDS={{ watchdog_timeout_seconds }}
{% endif %}
{% if watchdog_check_interval_seconds is defined %}
WATCHDOG_CHECK_INTERVAL_SECONDS={{ watchdog_check_interval_seconds }}
{% endif %}
{% if watchdog_reboot_cooldown_seconds is defined %}
WATCHDOG_REBOOT_COOLDOWN_SECONDS={{ watchdog_reboot_cooldown_seconds }}
{% endif %}
